{
  "name": "diff",
  "scopeName": "source.diff",
  "patterns": [
    {
      "name": "meta.diff.header",
      "match": "^(--- |\\+\\+\\+ |@@|diff |index ).*$"
    },
    {
      "name": "markup.inserted",
      "match": "^\\+.*$"
    },
    {
      "name": "markup.deleted",
      "match": "^-.*$"
    }
  ]
}
