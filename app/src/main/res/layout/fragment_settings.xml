<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="-1px"
    android:layout_height="-1px"
    android:orientation="vertical"
    android:background="#121212">

    <!-- Sub-navigation Header for Settings -->
    <LinearLayout
        android:layout_width="-1px"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#1E1E28"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <TextView
            android:id="@+id/btn_settings_models"
            android:layout_width="0dp"
            android:layout_height="-1px"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🧠 Models"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="#2C2C3A"/>

        <TextView
            android:id="@+id/btn_settings_permissions"
            android:layout_width="0dp"
            android:layout_height="-1px"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🔒 Permissions"
            android:textColor="#A0A0A0"
            android:textSize="14sp"
            android:background="#1E1E28"/>

        <TextView
            android:id="@+id/btn_settings_logs"
            android:layout_width="0dp"
            android:layout_height="-1px"
            android:layout_weight="1"
            android:gravity="center"
            android:text="📋 Logs"
            android:textColor="#A0A0A0"
            android:textSize="14sp"
            android:background="#1E1E28"/>
    </LinearLayout>

    <!-- Settings Sub-Container -->
    <FrameLayout
        android:id="@+id/settings_content_frame"
        android:layout_width="-1px"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
