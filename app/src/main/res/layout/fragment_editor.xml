<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1E1E2E">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/editor_topbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#181825"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/tv_file_path"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="start"
            android:singleLine="true"
            android:scrollHorizontally="true"
            android:text="No file open"
            android:textColor="#CDD6F4"
            android:textSize="13sp"
            android:typeface="monospace"
            android:layout_marginEnd="12dp" />

        <ImageButton
            android:id="@+id/btn_undo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_undo"
            android:scaleType="centerInside"
            android:contentDescription="Undo selected changes"
            android:visibility="gone"
            android:padding="6dp" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Save"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#11111B"
            android:background="@drawable/bg_btn_primary"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:enabled="false" />

        <ImageButton
            android:id="@+id/btn_more"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more_vert"
            android:scaleType="centerInside"
            android:contentDescription="More options"
            android:padding="6dp" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <io.github.rosemoe.sora.widget.CodeEditor
            android:id="@+id/code_editor"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Overlay container for Checkboxes and Undo buttons on top of changed lines -->
        <FrameLayout
            android:id="@+id/overlay_hunks_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false" />

    </FrameLayout>

</LinearLayout>
