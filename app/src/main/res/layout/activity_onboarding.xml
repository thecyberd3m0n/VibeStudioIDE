<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="-1px"
    android:layout_height="-1px"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="20dp"
    android:fitsSystemWindows="true">

    <!-- Top Stepper Header Bar -->
    <LinearLayout
        android:layout_width="-1px"
        android:layout_height="-2px"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <!-- Step 1 Item -->
        <LinearLayout
            android:layout_width="-2px"
            android:layout_height="-2px"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/step1_indicator"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_step_circle_active"
                android:textColor="#FFFFFF"
                android:text="1"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/step1_title"
                android:layout_width="-2px"
                android:layout_height="-2px"
                android:text="Welcome"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginLeft="6dp" />
        </LinearLayout>

        <!-- Divider Line 1 -->
        <View
            android:id="@+id/step_divider_1"
            android:layout_width="16dp"
            android:layout_height="2dp"
            android:background="#333333"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp" />

        <!-- Step 2 Item (Environment Install) -->
        <LinearLayout
            android:layout_width="-2px"
            android:layout_height="-2px"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/step2_indicator"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_step_circle_inactive"
                android:textColor="#888888"
                android:text="2"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/step2_title"
                android:layout_width="-2px"
                android:layout_height="-2px"
                android:text="Environment"
                android:textColor="#666666"
                android:textSize="12sp"
                android:layout_marginLeft="6dp" />
        </LinearLayout>

        <!-- Divider Line 2 -->
        <View
            android:id="@+id/step_divider_2"
            android:layout_width="16dp"
            android:layout_height="2dp"
            android:background="#333333"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp" />

        <!-- Step 3 Item (Version Control) -->
        <LinearLayout
            android:layout_width="-2px"
            android:layout_height="-2px"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/step3_indicator"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_step_circle_inactive"
                android:textColor="#888888"
                android:text="3"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/step3_title"
                android:layout_width="-2px"
                android:layout_height="-2px"
                android:text="Git"
                android:textColor="#666666"
                android:textSize="12sp"
                android:layout_marginLeft="6dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Content Card Area -->
    <FrameLayout
        android:layout_width="-1px"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card"
        android:padding="20dp">

        <!-- Step 1 Content -->
        <LinearLayout
            android:id="@+id/step1_layout"
            android:layout_width="-1px"
            android:layout_height="-1px"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="visible">

            <TextView
                android:layout_width="-2px"
                android:layout_height="-2px"
                android:text="🚀"
                android:textSize="64sp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="-2px"
                android:layout_height="-2px"
                android:text="Welcome to VibeStudio IDE"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="-2px"
                android:layout_height="-2px"
                android:text="Your modern, portable AI-driven development environment running natively on Android."
                android:textColor="#AAAAAA"
                android:textSize="14sp"
                android:gravity="center"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <!-- Step 2 Content (Environment Installation) -->
        <LinearLayout
            android:id="@+id/step2_layout"
            android:layout_width="-1px"
            android:layout_height="-1px"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="-2px"
                android:layout_height="-2px"
                android:text="🐧"
                android:textSize="54sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="-2px"
                android:layout_height="-2px"
                android:text="Installing Environment"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/status_message"
                android:layout_width="-2px"
                android:layout_height="-2px"
                android:text="Preparing proot Linux environment with bash..."
                android:textColor="#3B82F6"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <!-- Log Terminal Output View -->
            <RelativeLayout
                android:layout_width="-1px"
                android:layout_height="160dp"
                android:layout_marginBottom="12dp">

                <ScrollView
                    android:id="@+id/install_log_scroll"
                    android:layout_width="-1px"
                    android:layout_height="-1px"
                    android:background="#0A0A0A"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/install_log_text"
                        android:layout_width="-1px"
                        android:layout_height="-2px"
                        android:textColor="#00FF66"
                        android:textSize="11sp"
                        android:typeface="monospace"
                        android:textIsSelectable="true"
                        android:text="[installer] Ready to set up Termux-like environment.\n[installer] Target: /data/data/com.vibestudio.app/files/usr\n" />
                </ScrollView>

                <Button
                    android:id="@+id/btn_copy_logs"
                    android:layout_width="-2px"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentTop="true"
                    android:layout_margin="8dp"
                    android:text="Copy Logs"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:background="@drawable/bg_btn_secondary"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp" />
            </RelativeLayout>

        </LinearLayout>

        <!-- Step 3 Content (Configure Version Control) -->
        <LinearLayout
            android:id="@+id/step3_layout"
            android:layout_width="-1px"
            android:layout_height="-1px"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="gone"
            android:padding="8dp">

            <TextView
                android:layout_width="-2px"
                android:layout_height="-2px"
                android:text="🔧"
                android:textSize="48sp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="-2px"
                android:layout_height="-2px"
                android:text="Configure Version Control"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Section 1: Git User and Email -->
            <LinearLayout
                android:layout_width="-1px"
                android:layout_height="-2px"
                android:orientation="vertical"
                android:background="#1E1E1E"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="-1px"
                    android:layout_height="-2px"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="-2px"
                        android:layout_weight="1"
                        android:text="Configure Git User and Email"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txt_git_user_checkmark"
                        android:layout_width="-2px"
                        android:layout_height="-2px"
                        android:text="✓"
                        android:textColor="#10B981"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:layout_width="-2px"
                    android:layout_height="-2px"
                    android:text="Set global author name and email for Git commits."
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <!-- Display Configured Credentials Above Button -->
                <TextView
                    android:id="@+id/txt_git_user_credentials"
                    android:layout_width="-1px"
                    android:layout_height="-2px"
                    android:textColor="#10B981"
                    android:textSize="12sp"
                    android:typeface="monospace"
                    android:background="#121212"
                    android:padding="8dp"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_config_git_user"
                    android:layout_width="-2px"
                    android:layout_height="36dp"
                    android:text="Configure"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_btn_primary"
                    android:textSize="12sp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp" />
            </LinearLayout>

            <!-- Section 2: SSH Keys -->
            <LinearLayout
                android:layout_width="-1px"
                android:layout_height="-2px"
                android:orientation="vertical"
                android:background="#1E1E1E"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="-1px"
                    android:layout_height="-2px"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="-2px"
                        android:layout_weight="1"
                        android:text="Configure SSH keys"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txt_ssh_keys_checkmark"
                        android:layout_width="-2px"
                        android:layout_height="-2px"
                        android:text="✓"
                        android:textColor="#10B981"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:layout_width="-2px"
                    android:layout_height="-2px"
                    android:text="Generate or import SSH keys for remote Git repositories."
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btn_config_ssh_keys"
                    android:layout_width="-2px"
                    android:layout_height="36dp"
                    android:text="Configure"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_btn_primary"
                    android:textSize="12sp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:layout_marginBottom="10dp" />

                <!-- Copyable SSH Public Key TextField Container -->
                <LinearLayout
                    android:layout_width="-1px"
                    android:layout_height="-2px"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#121212"
                    android:padding="6dp">

                    <EditText
                        android:id="@+id/txt_ssh_public_key"
                        android:layout_width="0dp"
                        android:layout_height="-2px"
                        android:layout_weight="1"
                        android:text="not configured"
                        android:textColor="#AAAAAA"
                        android:textSize="11sp"
                        android:typeface="monospace"
                        android:background="@null"
                        android:focusable="false"
                        android:cursorVisible="false"
                        android:longClickable="true"
                        android:textIsSelectable="true"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:paddingLeft="4dp"
                        android:paddingRight="4dp" />

                    <Button
                        android:id="@+id/btn_copy_ssh_key"
                        android:layout_width="-2px"
                        android:layout_height="32dp"
                        android:text="📋 Copy"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:background="@drawable/bg_btn_secondary"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- Bottom Action Navigation -->
    <LinearLayout
        android:layout_width="-1px"
        android:layout_height="-2px"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Back"
            android:textColor="#CCCCCC"
            android:background="@drawable/bg_btn_secondary"
            android:textSize="14sp"
            android:visibility="invisible"
            android:layout_marginRight="8dp" />

        <Button
            android:id="@+id/btn_next"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Next"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginLeft="8dp" />

    </LinearLayout>

</LinearLayout>
