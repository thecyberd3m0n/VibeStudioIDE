<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="-1px"
    android:layout_height="-1px"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="20dp"
    android:fitsSystemWindows="true">

    <!-- Top Stepper Header Bar -->
    <LinearLayout
        android:layout_width="-1px"
        android:layout_height="-2px"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <!-- Step 1 Item -->
        <LinearLayout
            android:layout_width="-2px"
            android:layout_height="-2px"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/step1_indicator"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_step_circle_active"
                android:textColor="#FFFFFF"
                android:text="1"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/step1_title"
                android:layout_width="-2px"
                android:layout_height="-2px"
                android:text="Welcome"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginLeft="6dp" />
        </LinearLayout>

        <!-- Divider Line 1 -->
        <View
            android:id="@+id/step_divider_1"
            android:layout_width="24dp"
            android:layout_height="2dp"
            android:background="#333333"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp" />

        <!-- Step 2 Item -->
        <LinearLayout
            android:layout_width="-2px"
            android:layout_height="-2px"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/step2_indicator"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_step_circle_inactive"
                android:textColor="#888888"
                android:text="2"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/step2_title"
                android:layout_width="-2px"
                android:layout_height="-2px"
                android:text="Features"
                android:textColor="#666666"
                android:textSize="12sp"
                android:layout_marginLeft="6dp" />
        </LinearLayout>

        <!-- Divider Line 2 -->
        <View
            android:id="@+id/step_divider_2"
            android:layout_width="24dp"
            android:layout_height="2dp"
            android:background="#333333"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp" />

        <!-- Step 3 Item (Environment Install) -->
        <LinearLayout
            android:layout_width="-2px"
            android:layout_height="-2px"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/step3_indicator"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_step_circle_inactive"
                android:textColor="#888888"
                android:text="3"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/step3_title"
                android:layout_width="-2px"
                android:layout_height="-2px"
                android:text="Environment"
                android:textColor="#666666"
                android:textSize="12sp"
                android:layout_marginLeft="6dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Content Card Area -->
    <FrameLayout
        android:layout_width="-1px"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card"
        android:padding="20dp">

        <!-- Step 1 Content -->
        <LinearLayout
            android:id="@+id/step1_layout"
            android:layout_width="-1px"
            android:layout_height="-1px"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="visible">

            <TextView
                android:layout_width="-2px"
                android:layout_height="-2px"
                android:text="🚀"
                android:textSize="64sp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="-2px"
                android:layout_height="-2px"
                android:text="Welcome to VibeStudio IDE"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="-2px"
                android:layout_height="-2px"
                android:text="Your modern, portable AI-driven development environment running natively on Android."
                android:textColor="#AAAAAA"
                android:textSize="14sp"
                android:gravity="center"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <!-- Step 2 Content -->
        <LinearLayout
            android:id="@+id/step2_layout"
            android:layout_width="-1px"
            android:layout_height="-1px"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="-2px"
                android:layout_height="-2px"
                android:text="⚡"
                android:textSize="64sp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="-2px"
                android:layout_height="-2px"
                android:text="Powerful Toolkit"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="-2px"
                android:layout_height="-2px"
                android:text="Seamlessly manage AI models, connect MCP tools, run shell commands in built-in terminal and chat with AI."
                android:textColor="#AAAAAA"
                android:textSize="14sp"
                android:gravity="center"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <!-- Step 3 Content (Proot Environment Installation) -->
        <LinearLayout
            android:id="@+id/step3_layout"
            android:layout_width="-1px"
            android:layout_height="-1px"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="-2px"
                android:layout_height="-2px"
                android:text="🐧"
                android:textSize="54sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="-2px"
                android:layout_height="-2px"
                android:text="Installing Environment"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/status_message"
                android:layout_width="-2px"
                android:layout_height="-2px"
                android:text="Preparing proot Linux environment with bash..."
                android:textColor="#3B82F6"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <!-- Log Terminal Output View -->
            <RelativeLayout
                android:layout_width="-1px"
                android:layout_height="160dp"
                android:layout_marginBottom="12dp">

                <ScrollView
                    android:id="@+id/install_log_scroll"
                    android:layout_width="-1px"
                    android:layout_height="-1px"
                    android:background="#0A0A0A"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/install_log_text"
                        android:layout_width="-1px"
                        android:layout_height="-2px"
                        android:textColor="#00FF66"
                        android:textSize="11sp"
                        android:typeface="monospace"
                        android:textIsSelectable="true"
                        android:text="[installer] Ready to set up Termux-like environment.\n[installer] Target: /data/data/com.vibestudio.app/files/usr\n" />
                </ScrollView>

                <Button
                    android:id="@+id/btn_copy_logs"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentTop="true"
                    android:layout_margin="8dp"
                    android:text="Copy Logs"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:background="@drawable/bg_btn_secondary"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp" />
            </RelativeLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- Bottom Action Navigation -->
    <LinearLayout
        android:layout_width="-1px"
        android:layout_height="-2px"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Back"
            android:textColor="#CCCCCC"
            android:background="@drawable/bg_btn_secondary"
            android:textSize="14sp"
            android:visibility="invisible"
            android:layout_marginRight="8dp" />

        <Button
            android:id="@+id/btn_next"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Next"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginLeft="8dp" />

    </LinearLayout>

</LinearLayout>
