<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="-1px"
    android:layout_height="-1px"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="-1px"
        android:layout_height="-2px"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Header / Logo banner -->
        <LinearLayout
            android:layout_width="-1px"
            android:layout_height="-2px"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="🚀"
                android:textSize="32sp"
                android:gravity="center"
                android:background="#1E1E28"
                android:padding="4dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="-2px"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingLeft="16dp">

                <TextView
                    android:layout_width="-2px"
                    android:layout_height="-2px"
                    android:text="VibeStudio Launcher"
                    android:textColor="#03DAC6"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="-2px"
                    android:layout_height="-2px"
                    android:text="Select a tool to start a new session"
                    android:textColor="#A0A0A0"
                    android:textSize="13sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="-1px"
            android:layout_height="1dp"
            android:background="#2C2C38"
            android:layout_marginBottom="24dp"/>

        <!-- Grid / List of Launcher Options -->

        <!-- Option 1: Assistant Chat -->
        <LinearLayout
            android:id="@+id/btn_launch_chat"
            android:layout_width="-1px"
            android:layout_height="-2px"
            android:orientation="horizontal"
            android:background="#1E1E28"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="💬"
                android:textSize="24sp"
                android:gravity="center"
                android:background="#2A2A38"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="-2px"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingLeft="16dp">

                <TextView
                    android:layout_width="-2px"
                    android:layout_height="-2px"
                    android:text="Open Assistant Chat"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="-2px"
                    android:layout_height="-2px"
                    android:text="Start an AI workspace chat session with local tools"
                    android:textColor="#8E8E93"
                    android:textSize="12sp"/>
            </LinearLayout>

            <TextView
                android:layout_width="-2px"
                android:layout_height="-2px"
                android:text="➔"
                android:textColor="#BB86FC"
                android:textSize="18sp"/>
        </LinearLayout>

        <!-- Option 2: Browser -->
        <LinearLayout
            android:id="@+id/btn_launch_browser"
            android:layout_width="-1px"
            android:layout_height="-2px"
            android:orientation="horizontal"
            android:background="#1E1E28"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="🌐"
                android:textSize="24sp"
                android:gravity="center"
                android:background="#2A2A38"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="-2px"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingLeft="16dp">

                <TextView
                    android:layout_width="-2px"
                    android:layout_height="-2px"
                    android:text="Open Browser"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="-2px"
                    android:layout_height="-2px"
                    android:text="Launch integrated web view with AI browser MCP"
                    android:textColor="#8E8E93"
                    android:textSize="12sp"/>
            </LinearLayout>

            <TextView
                android:layout_width="-2px"
                android:layout_height="-2px"
                android:text="➔"
                android:textColor="#BB86FC"
                android:textSize="18sp"/>
        </LinearLayout>

        <!-- Option 3: Terminal -->
        <LinearLayout
            android:id="@+id/btn_launch_terminal"
            android:layout_width="-1px"
            android:layout_height="-2px"
            android:orientation="horizontal"
            android:background="#1E1E28"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="💻"
                android:textSize="24sp"
                android:gravity="center"
                android:background="#2A2A38"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="-2px"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingLeft="16dp">

                <TextView
                    android:layout_width="-2px"
                    android:layout_height="-2px"
                    android:text="Open Terminal"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="-2px"
                    android:layout_height="-2px"
                    android:text="Open local terminal session with full PTY/shell support"
                    android:textColor="#8E8E93"
                    android:textSize="12sp"/>
            </LinearLayout>

            <TextView
                android:layout_width="-2px"
                android:layout_height="-2px"
                android:text="➔"
                android:textColor="#BB86FC"
                android:textSize="18sp"/>
        </LinearLayout>

        <!-- Option 4: Settings -->
        <LinearLayout
            android:id="@+id/btn_launch_settings"
            android:layout_width="-1px"
            android:layout_height="-2px"
            android:orientation="horizontal"
            android:background="#1E1E28"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="⚙️"
                android:textSize="24sp"
                android:gravity="center"
                android:background="#2A2A38"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="-2px"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingLeft="16dp">

                <TextView
                    android:layout_width="-2px"
                    android:layout_height="-2px"
                    android:text="Settings"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="-2px"
                    android:layout_height="-2px"
                    android:text="Configure AI models, permissions, logs &amp; system options"
                    android:textColor="#8E8E93"
                    android:textSize="12sp"/>
            </LinearLayout>

            <TextView
                android:layout_width="-2px"
                android:layout_height="-2px"
                android:text="➔"
                android:textColor="#BB86FC"
                android:textSize="18sp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
